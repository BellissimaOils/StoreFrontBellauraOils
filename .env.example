# ─────────────────────────────────────────────────────────────────────────────
# Bellaura Oils — PUBLIC STOREFRONT Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit your actual .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare D1 Database ──────────────────────────────────────────────────
CLOUDFLARE_D1_API_TOKEN=
CLOUDFLARE_D1_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# ── Cloudflare R2 Storage (Images & Media) ─────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# ── Telegram Order Notifications ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Store Domain & Server Settings ─────────────────────────────────────────
STORE_URL=https://www.bellauraoils.com
PORT=3000
NODE_ENV=production
