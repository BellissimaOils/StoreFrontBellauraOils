# ─────────────────────────────────────────────────────────────────────────────
# Bellaura Oils — PUBLIC STOREFRONT environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudflare D1 — READ access (products, sections, reviews, orders) ────────
CLOUDFLARE_D1_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# Use a token with D1:read permission only (not the admin write token)
CLOUDFLARE_D1_TOKEN=

# ── Cloudflare R2 — READ access for product images ───────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Store domain ─────────────────────────────────────────────────────────────
STORE_URL=https://www.bellauraoils.com
# Override SITE_ORIGIN if needed (defaults to STORE_URL)
# SITE_ORIGIN=https://www.bellauraoils.com

# ── Telegram — for ORDER NOTIFICATION only (stays server-side, never exposed) ─
# The storefront sends a Telegram notification when a new order is created.
# These credentials are NEVER sent to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Gemini AI — for order confirmation email generation ──────────────────────
GEMINI_API_KEY=

# ── Clerk — publishable key only (server secret key is admin-only) ───────────
VITE_CLERK_PUBLISHABLE_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── SECURITY NOTES ───────────────────────────────────────────────────────────
# The following credentials must ONLY be set in the Admin Dashboard project:
#   JWT_SECRET          — admin authentication signing key
#   SENDIT_USERNAME     — Sendit shipping API
#   SENDIT_PASSWORD     — Sendit shipping API
#   CLERK_SECRET_KEY    — Clerk backend verification
#   R2_WebHook_*        — Webhook storage bucket
# Do NOT add them here.
